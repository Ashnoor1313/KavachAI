# Kavach AI - Gnani.ai API Configuration
# Gnani AI Prisma v2.5 (Streaming Speech-to-Text) & Timbre v2.5 (Text-to-Speech)

GNANI_API_KEY=your_gnani_api_key_here
GNANI_TOKEN=your_gnani_auth_token_here
GNANI_STT_URL=https://api.gnani.ai/prisma/v2.5/stt
GNANI_TTS_URL=https://api.gnani.ai/timbre/v2.5/tts

# App Settings
DEMO_SIMULATION_MODE=true
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Compliance & Safe Demo Flags
DPDP_COMPLIANCE_MODE=true
SYNTHETIC_DATA_ONLY=true
